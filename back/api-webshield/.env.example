# DB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=webshield

# HTTP/HTTPS
API_HOST=127.0.0.1
API_PORT=3001
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem

# CORS (origins permitidos)
ALLOWED_ORIGINS=https://localhost:5173,https://127.0.0.1:5173

# Auth — JWT
# CAMBIAR EN PROD. Genera uno random con: openssl rand -base64 32
JWT_SECRET=change_me_in_production_use_openssl_rand
JWT_EXPIRES_IN=7d
COOKIE_NAME=webshield_session
COOKIE_SAMESITE=Strict

# Modelo ML (sirve en VLAN del TEC, accesible solo desde la red del campus)
MODEL_API_URL=https://172.16.67.67
MODEL_API_KEY=
MODEL_API_TIMEOUT_MS=5000

# Bearer token compartido con el WAF para POST /api/ingest/events
INGEST_API_TOKEN=change-this-long-random-token
